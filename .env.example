# .env.example — names only; copy to .env (gitignored) and fill in YOUR OWN dev project's values.
# Tier 1 (`make dev`) needs none of these. Set all five Supabase variables or none — half is refused by
# scripts/env_validate.py. Every variable is explained in docs/ENVIRONMENT.md.

# API (server only — never reaches the browser)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Browser (baked into the bundle at build time; the anon key is public by design — see docs/ENVIRONMENT.md)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
