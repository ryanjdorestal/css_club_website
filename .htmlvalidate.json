{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "require-sri": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "element-required-attributes": "error",
    "wcag/h37": "error",
    "input-missing-label": "error",
    "no-dup-id": "error",
    "prefer-native-element": "off",
    "attribute-boolean-style": "off",
    "void-style": "off",
    "doctype-style": "off",
    "no-implicit-button-type": "warn"
  }
}
