{
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "max-params": [
      "error",
      {
        "max": 3
      }
    ],
    "max-depth": ["error", 4],
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 40,
        "skipBlankLines": true,
        "skipComments": true,
        "IIFEs": true
      }
    ],
    "complexity": [
      "error",
      {
        "max": 10
      }
    ],
    "no-warning-comments": [
      "error",
      {
        "terms": ["todo", "fixme", "xxx"],
        "location": "anywhere"
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.tsx"],
      "rules": {
        "max-lines-per-function": [
          "error",
          {
            "max": 200,
            "skipBlankLines": true,
            "skipComments": true,
            "IIFEs": true
          }
        ],
        "complexity": [
          "error",
          {
            "max": 25
          }
        ]
      }
    },
    {
      "files": ["**/os/ui/specs/*.ts"],
      "rules": {
        "max-lines-per-function": [
          "error",
          {
            "max": 60,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-params": [
          "error",
          {
            "max": 4
          }
        ],
        "complexity": [
          "error",
          {
            "max": 20
          }
        ]
      }
    },
    {
      "files": ["**/os/OsToday.tsx", "**/os/OsInheritance.tsx", "**/os/OsSystem.tsx", "**/components/cards/FolderCard.tsx"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 80
          }
        ]
      }
    },
    {
      "files": ["qa-scripts/**"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 20
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 80
          }
        ]
      }
    }
  ]
}
