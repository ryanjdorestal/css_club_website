{
  "ci": {
    "collect": {
      "url": ["http://localhost:4173/", "http://localhost:4173/projects"],
      "startServerCommand": "npx vite preview --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "budgetPath": "budget.json" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 921600 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
