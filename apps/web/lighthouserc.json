{
  "ci": {
    "collect": {
      "url": ["http://localhost:4173/", "http://localhost:4173/projects"],
      "startServerCommand": "npx vite preview --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "budgetPath": "budget.json",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 921600
          }
        ],
        "resource-summary:font:size": [
          "error",
          {
            "maxNumericValue": 409600
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 2662400
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-report"
    }
  }
}
