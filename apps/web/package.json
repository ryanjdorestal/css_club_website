{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "shoot": "node qa-scripts/shoot.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "prune": "ts-prune -p tsconfig.app.json --ignore \"sigils/index|textures/index|frame/index|brand.config|api.types\" --error",
    "depcheck": "depcheck",
    "format": "prettier --write ../.. --ignore-path ../../.prettierignore",
    "format:check": "prettier --check ../.. --ignore-path ../../.prettierignore",
    "lint:css": "stylelint 'src/**/*.css' --config ../../.stylelintrc.json",
    "lint:html": "html-validate --config ../../.htmlvalidate.json dist/index.html index.html",
    "lint:md": "cd ../.. && markdownlint --config .markdownlint.json --ignore-path .markdownlintignore \"**/*.md\"",
    "a11y:pa11y": "pa11y-ci --config ../../.pa11yci.json",
    "a11y:axe": "node qa-scripts/axe.mjs",
    "audit:routes": "node qa-scripts/route_validator.mjs",
    "audit:images": "node qa-scripts/broken_image_scan.mjs",
    "audit:tokens": "node qa-scripts/tokens_gate.mjs",
    "audit:repo": "node ../../scripts/repo_audit.mjs",
    "smoke:functional": "node ../../scripts/functional_smoke.mjs",
    "gate": "node qa-scripts/os_gate.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "depcheck": "^1.4.7",
    "html-validate": "^11.16.0",
    "markdownlint-cli": "^0.49.1",
    "oxlint": "^1.81.0",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-prune": "^0.10.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
