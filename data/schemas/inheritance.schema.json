{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inheritance record frontmatter (content/inheritance/<term>/…)",
  "type": "object",
  "required": ["type", "title", "term", "date", "status", "owners", "visibility"],
  "additionalProperties": false,
  "properties": {
    "type": { "enum": ["roster", "handoff", "decision", "project", "event", "contact", "lesson", "minutes"] },
    "title": { "type": "string", "minLength": 1 },
    "term": { "type": "string", "pattern": "^[FSW]\\d{2}(-[FSW]\\d{2})?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "enum": ["draft", "final", "superseded"] },
    "owners": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "visibility": { "enum": ["board", "public"] },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "role": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "summary": { "type": "string" },
    "links": { "type": "array", "items": { "type": "object", "required": ["label", "url"], "properties": { "label": { "type": "string" }, "url": { "type": "string", "pattern": "^https?://" } } } },
    "supersedes": { "type": "string" },
    "succeeded_by": { "type": "string" },
    "related": { "type": "array", "items": { "type": "string" } }
  },
  "x-rules": [
    "owners must be names or roles on that term's roster (or 'the board'); never emails",
    "supersedes / succeeded_by / related must resolve to existing record ids and form no cycle",
    "visibility: public records contain no email addresses or phone numbers",
    "no record anywhere contains a secret-shaped string (keys, tokens, webhooks, private keys)",
    "attachments are links only — the platform stores no uploads for inheritance"
  ]
}
