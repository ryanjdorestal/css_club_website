  {
    "id": "F23-S24/leandro-gamarra",
    "term": "F23-S24",
    "name": "Leandro Gamarra",
    "role_title": "Assistant VP Deputy",
    "group_label": "Executive Board Members",
    "email": "",
    "photo_path": "img/board/leandro.webp",
    "bio": "Hi! I was the President of the club from June 2021 - June 2023. We have an amazing team here at the CSS Club. I was in charge of leading the club into new levels, like having our first CUNY-wide John Jay Hackathon, growing from 40 members to 540+ members, creating the Club's Website, and having new workshops like React, Python, Swift, MySQL, Git/GitHub, Technical Interview Prep, Javascript, Career Prep , HTML/CSS, Cybersecurity topics, and creating new Assistant Exec Positions, as well as the Web Developer, Data Analytics, Photographer, and Journalist roles. Now, I assist the club as Assistant VP Deputy.",
    "socials": {
      "linkedin": "https://www.linkedin.com/in/leandro-gamarra/",
      "github": "https://github.com/r0m3c"
    },
    "sort": 7,
    "active": false,
    "os_role": "officer"
  },
  {
    "id": "F22-S23/leandro-gamarra",
