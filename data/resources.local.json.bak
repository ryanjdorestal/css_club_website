  {
    "id": "web-development/full-stack-web-development",
    "group": "Web Development",
    "title": "Full Stack Web Development",
    "url": "https://github.com/bmorelli25/Become-A-Full-Stack-Web-Developer",
    "description": "Interested in Full Stack? Check out these 100+ free resources to get you started. These resources contain anything from learning HTML/CSS, Python, SQL, to APIs, and Node.js. This is great way to get started.",
    "sort": 1,
