# deps
node_modules/
.venv/
__pycache__/
*.pyc

# builds
dist/
apps/web/dist/

# env — never committed (the example with names only is the exception)
.env
.env.*
!.env.example

# caches
.cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.DS_Store
*.log

# playwright
apps/web/test-results/
apps/web/playwright-report/
qa/_review/

# OS Tier-1 local tables (never committed; scripts/snapshot.py refreshes the committed JSON)
data/*.local.json
data/*.local.json.bak

# QA loop history (kept locally, not committed)
qa/archive/

# run-8 slim: loop screenshots stay local (make shots / make smoke regenerate them); parity.md is the record
qa/loops/*
!qa/loops/parity.md

# reference material lives outside the repo at ~/Desktop/jjay_css_refs/ (assets/refs/README.md)
assets/refs/*
!assets/refs/README.md

# lhci writes reports next to the app; the numbers live in the job summary and the artifact.
apps/web/.lighthouseci/
apps/web/.lighthouseci-report/
